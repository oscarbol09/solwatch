{
  "name": "solwatch",
  "version": "0.1.0",
  "description": "Production-grade, read-only Solana wallet monitor and multi-channel alert router built with TypeScript, @solana/kit, Node 24 SQLite WAL, and zero cloud infrastructure cost.",
  "private": true,
  "type": "module",
  "author": "Oscar Bolaño <oscarbol09@gmail.com> (https://github.com/oscarbol09)",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/oscarbol09/solwatch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oscarbol09/solwatch.git"
  },
  "bugs": {
    "url": "https://github.com/oscarbol09/solwatch/issues"
  },
  "keywords": [
    "solana",
    "solana-kit",
    "wallet-tracker",
    "sqlite-wal",
    "telegram-bot",
    "blockchain",
    "crypto-alerts",
    "jupiter-ag",
    "helius",
    "hono",
    "pino",
    "web3"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "dev:pretty": "node --env-file-if-exists=.env --import tsx src/index.ts | pino-pretty",
    "demo": "node --env-file-if-exists=.env --import tsx src/demo.ts",
    "backup": "node --env-file-if-exists=.env --import tsx src/scripts/backup.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@solana/kit": "^8.6.0",
    "grammy": "^1.48.0",
    "hono": "^4.13.21",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.1.1",
    "fast-check": "^4.11.0",
    "msw": "^3.0.7",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
