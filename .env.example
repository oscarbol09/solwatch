# Solana RPC endpoints (Mainnet or Devnet)
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed

# Persistence (SQLite WAL file path)
DATABASE_PATH=./data/solwatch.db

# HTTP API server
PORT=3000
HOST=0.0.0.0
# Optional bearer token protecting /api/* routes (leave empty for local-only use)
API_TOKEN=
# Optional Helius Enhanced Webhook authentication secret (Authorization header)
HELIUS_WEBHOOK_SECRET=

# Notifiers (all optional; console alerts can be enabled independently)
CONSOLE_ALERTS_ENABLED=true

# Telegram Bot & Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# Optional comma-separated list of authorized Telegram chat IDs for interactive commands
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_INTERACTIVE_ENABLED=false

# Discord Webhook Alerts
DISCORD_WEBHOOK_URL=

# Generic JSON Webhook Alerts (HMAC-SHA256 signed via X-Solwatch-Signature)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Operational tuning
MIN_SOL_ALERT=0.1
DEFAULT_COOLDOWN_SECONDS=0
INCLUDE_FAILED_TX=false
LOG_LEVEL=info
