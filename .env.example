# Solana RPC endpoints (Mainnet or Devnet)
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed

# Persistence (SQLite WAL file path)
DATABASE_PATH=./data/solwatch.db

# HTTP API server & embedded dashboard
PORT=3000
HOST=127.0.0.1
DASHBOARD_ENABLED=true
CORS_ORIGIN=
# Minimum 32 characters; API_TOKEN is required when binding HOST beyond loopback
API_TOKEN=
HELIUS_WEBHOOK_SECRET=
ALLOW_UNAUTHENTICATED_API=false
TRUST_PROXY=false
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
MAX_WATCHED_WALLETS=100

# Notifiers (all optional; console alerts can be enabled independently)
CONSOLE_ALERTS_ENABLED=true

# Telegram Bot & Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# Optional supergroup forum topic ID for outbound alerts
TELEGRAM_ALERT_THREAD_ID=
# Required comma-separated numeric chat IDs when TELEGRAM_INTERACTIVE_ENABLED=true
TELEGRAM_ALLOWED_CHAT_IDS=
# Required when group chat IDs (negative) are allowed; scopes /watch, /unwatch, /pause, /resume, /setmin, /denylist, /test
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_INTERACTIVE_ENABLED=false

# Discord Webhook Alerts (https://discord.com/api/webhooks/...)
DISCORD_WEBHOOK_URL=

# Generic JSON Webhook Alerts (HMAC-SHA256 signed with X-Solwatch-Timestamp + X-Solwatch-Signature)
# WEBHOOK_SECRET must be at least 32 characters when configured; WEBHOOK_URL requires https:// public hosts
WEBHOOK_URL=
WEBHOOK_SECRET=
ALLOW_PRIVATE_WEBHOOK_URLS=false

# Operational tuning & zero-cost USD enrichment (Jupiter APIs + SQLite cache)
MIN_SOL_ALERT=0.1
MIN_USD_ALERT=
PRICE_ENRICHMENT_ENABLED=true
DEFAULT_COOLDOWN_SECONDS=0
INCLUDE_FAILED_TX=false
LOG_LEVEL=info
