# ==============================================================================
# solwatch — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the channels and options you need:
#   cp .env.example .env
#
# All notification channels are optional. By default, solwatch runs with console
# output enabled and zero external cloud dependencies ($0/mo infrastructure cost).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Solana Network & RPC Configuration
# ------------------------------------------------------------------------------
# Cluster to monitor: "mainnet-beta" or "devnet"
SOLANA_CLUSTER=mainnet-beta

# Standard HTTP RPC endpoint for getTransaction and backfill queries
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# WebSocket endpoint for real-time logsNotifications subscriptions
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Commitment level for transaction confirmation: "confirmed" or "finalized"
SOLANA_COMMITMENT=confirmed

# ------------------------------------------------------------------------------
# 2. SQLite WAL Storage & Persistence
# ------------------------------------------------------------------------------
# Database file path (uses Node 24 native node:sqlite with WAL journal mode)
DATABASE_PATH=./data/solwatch.db

# ------------------------------------------------------------------------------
# 3. HTTP API Server, Embedded Web Console & Security
# ------------------------------------------------------------------------------
# Port and bind host for the Hono HTTP API server
PORT=3000
HOST=127.0.0.1

# Enable the embedded zero-CDN web management console at GET /
DASHBOARD_ENABLED=true

# Optional CORS Allowed-Origin header (leave empty to disable cross-origin requests)
CORS_ORIGIN=

# Bearer token for authenticating HTTP REST endpoints.
# MANDATORY if HOST is bound beyond loopback (e.g. 0.0.0.0). Minimum 32 characters.
API_TOKEN=

# Secret token for Helius Enhanced Webhook ingestion at POST /webhooks/helius.
# If unset, the /webhooks/helius endpoint returns 503 Service Unavailable (fail-closed).
HELIUS_WEBHOOK_SECRET=

# Set to true only in isolated local development to bypass API_TOKEN requirements on 0.0.0.0
# Prohibited when NODE_ENV=production
ALLOW_UNAUTHENTICATED_API=false

# Trust X-Forwarded-For headers from reverse proxies (Nginx, Traefik, Cloudflare)
TRUST_PROXY=false

# Rate limiting per IP on the HTTP API (requests per window)
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000

# Maximum number of concurrently tracked wallets
MAX_WATCHED_WALLETS=100

# ------------------------------------------------------------------------------
# 4. Outbound Notification Channels
# ------------------------------------------------------------------------------
# Output formatted alerts to process stdout
CONSOLE_ALERTS_ENABLED=true

# --- Telegram Bot & Alerts ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Destination chat ID for outbound alerts (numeric string, e.g. "12345678" or "-10012345678")
TELEGRAM_ALERT_CHAT_ID=

# Optional supergroup forum topic ID (message_thread_id) for organized channel alerts
TELEGRAM_ALERT_THREAD_ID=

# Comma-separated list of numeric chat IDs allowed to interact with the bot
TELEGRAM_ALLOWED_CHAT_IDS=

# Comma-separated list of numeric user IDs authorized to run administrative commands
# (/watch, /unwatch, /pause, /resume, /setmin, /denylist, /test). Required for group chats.
TELEGRAM_ALLOWED_USER_IDS=

# Enable interactive grammY bot commands (/watch, /list, /rules, /status, etc.)
TELEGRAM_INTERACTIVE_ENABLED=false

# --- Discord Webhook ---
# Incoming webhook URL (e.g. https://discord.com/api/webhooks/...)
DISCORD_WEBHOOK_URL=

# --- Generic JSON Webhook (HMAC-SHA256 Signed) ---
# Destination HTTPS endpoint for JSON webhook payloads (version 1.1)
WEBHOOK_URL=

# Secret key for HMAC-SHA256 payload signing (minimum 32 characters).
# Emits X-Solwatch-Timestamp, X-Solwatch-Delivery, and X-Solwatch-Signature headers.
WEBHOOK_SECRET=

# Set to true to allow private/local RFC 1918 webhook targets during testing (default: false)
ALLOW_PRIVATE_WEBHOOK_URLS=false

# ------------------------------------------------------------------------------
# 5. Rules Engine, USD Valuation & Operational Tuning
# ------------------------------------------------------------------------------
# Global minimum SOL transfer/swap threshold to trigger alerts (e.g. 0.1 SOL)
MIN_SOL_ALERT=0.1

# Optional global minimum USD valuation threshold to trigger alerts (e.g. 50.0 USD)
MIN_USD_ALERT=

# Enable zero-cost token price enrichment via Jupiter Lite API cached in SQLite
PRICE_ENRICHMENT_ENABLED=true

# Default anti-spam cooldown window in seconds per wallet/event-type (0 to disable)
DEFAULT_COOLDOWN_SECONDS=0

# Include failed on-chain transactions in alerts (default: false, suppressed)
INCLUDE_FAILED_TX=false

# Pino logger verbosity level: "fatal" | "error" | "warn" | "info" | "debug" | "silent"
LOG_LEVEL=info
